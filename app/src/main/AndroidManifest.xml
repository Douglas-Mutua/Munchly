<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MunchlyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Munchly">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AdminLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".ProductDetailsActivity" android:exported="false" />
        <activity android:name=".CartActivity" android:exported="false" />

        <activity
            android:name=".CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".MpesaPaymentActivity" android:exported="false" />
        <activity android:name=".OrderHistoryActivity" android:exported="false" />
        <activity android:name=".OrderDetailsActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />

        <activity android:name=".AdminDashboardActivity" android:exported="false" />
        <activity android:name=".AdminOrdersActivity" android:exported="false" />

        <activity
            android:name=".AdminProductManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>