<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_gravity="bottom"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="35dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- 1. Dashboard Item -->
        <LinearLayout
            android:id="@+id/navAdminDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navAdminDashboardIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Admin Dashboard"
                app:srcCompat="@drawable/ic_admin_dashboard"
                app:tint="#888888" />
        </LinearLayout>

        <!-- 2. Products Item -->
        <LinearLayout
            android:id="@+id/navAdminProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navAdminProductsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Admin Products"
                app:srcCompat="@drawable/ic_admin_products"
                app:tint="#888888" />
        </LinearLayout>

        <!-- 3. Orders Item -->
        <LinearLayout
            android:id="@+id/navAdminOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navAdminOrdersIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Admin Orders"
                app:srcCompat="@drawable/ic_admin_orders"
                app:tint="#888888" />
        </LinearLayout>

        <!-- 4. Logout Item -->
        <LinearLayout
            android:id="@+id/navAdminLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navAdminLogoutIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Admin Logout"
                app:srcCompat="@drawable/ic_admin_logout"
                app:tint="#E53935" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
