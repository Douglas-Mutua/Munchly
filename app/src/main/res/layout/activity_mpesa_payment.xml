<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF"
    android:padding="24dp"
    android:gravity="center">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_target"
        app:tint="#FF6B00"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/mpesa_target_icon_desc" />

    <TextView
        android:id="@+id/tvPaymentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mpesa_initial_prompt"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPaymentDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mpesa_placeholder_details"
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="#666666"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnConfirmPaid"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="I Have Entered PIN (Confirm Payment)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        app:cornerRadius="26dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCancelPayment"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cancel Payment"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:backgroundTint="#E53935"
        app:cornerRadius="26dp" />
</LinearLayout>
