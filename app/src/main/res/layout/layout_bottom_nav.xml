<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_gravity="bottom"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="35dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- 1. Home Item -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_home"
                app:srcCompat="@drawable/baseline_home_24"
                app:tint="@color/nav_icon_inactive" />
        </LinearLayout>

        <!-- 2. Cart Item -->
        <LinearLayout
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navCartIcon"
                android:layout_width="22dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_cart"
                app:srcCompat="@drawable/baseline_shopping_cart_24"
                app:tint="@color/nav_icon_inactive" />
        </LinearLayout>

        <!-- 3. Orders Item -->
        <LinearLayout
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navOrdersIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_orders"
                app:srcCompat="@drawable/baseline_receipt_long_24"
                app:tint="@color/nav_icon_inactive" />
        </LinearLayout>

        <!-- 4. Profile Item -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_profile"
                app:srcCompat="@drawable/baseline_person_24"
                app:tint="@color/nav_icon_inactive" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
